# ---------------------------------------------------------------------------
# ProofScreen API — copy to .env and fill in.
#
# Everything here has a working default EXCEPT the OpenAI key and the WhatsApp
# credentials. With neither set, the whole pipeline still runs offline in
# FIXTURE MODE: deterministic heuristics for claims and signal extraction,
# dry-run outbound WhatsApp. Scoring, weighting and consistency are identical
# in both modes — those never involve the model.
# ---------------------------------------------------------------------------

# --- database -------------------------------------------------------------
# docker compose overrides this to point at the `db` service.
# For a bare `uvicorn` run against the compose Postgres, use localhost:
DATABASE_URL=postgresql+asyncpg://proofscreen:proofscreen@localhost:5432/proofscreen

# --- llm ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
LLM_TIMEOUT_SECONDS=25
LLM_TEMPERATURE_EXTRACT=0.0
LLM_TEMPERATURE_QUESTION=0.4

# --- interview policy -----------------------------------------------------
# 5 probe levels x 3 claims = 15 possible; the adaptive stop usually lands at
# 8-10. Raising this past ~12 loses real candidates to WhatsApp drop-off.
MAX_QUESTIONS=12
MAX_CLAIMS=3
# false => strict VALIDATION..OUTCOME sweep instead of gap-driven probing
ADAPTIVE_PROBING=true
# Score each answer inline (needed for adaptive probing). false => background.
SCORE_INLINE=true

# Voice's share of a claim's score, applied ONLY to voice-answered claims.
# The voice signal is duration and word count and nothing else — accent,
# fluency and "confidence" are deliberately not measured. Set to 0 to remove
# the text/voice asymmetry entirely.
VOICE_WEIGHT=0.10

# --- WhatsApp Business Cloud API (Meta, direct) ---------------------------
# From Meta App Dashboard -> WhatsApp -> API Setup.
# Leave blank to run outbound in dry-run (inbound webhooks still parse).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Use a SYSTEM USER token, not a 24-hour test token, or the demo dies mid-day.
WHATSAPP_ACCESS_TOKEN=
# You invent this, then type the same value into the webhook config in Meta.
WHATSAPP_VERIFY_TOKEN=proofscreen-verify
# App secret, for X-Hub-Signature-256. Required if validation is on.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Turn this on before the webhook URL is public. Leave off while replaying
# payloads with curl.
WHATSAPP_VALIDATE_SIGNATURE=false
# An APPROVED template, needed to message a candidate who has not messaged us
# first (outside the 24-hour customer service window). Leave blank and the
# candidate must send their opt-in code to start.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- api ------------------------------------------------------------------
# Comma-separated. * = open (chosen for the hackathon build).
CORS_ORIGINS=*
ENABLE_DEV_ENDPOINTS=true

# --- resume_score contrast metric ----------------------------------------
# resume_score is keyword overlap against a job description. Pass
# job_description per candidate for the contrast to land; this is the fallback.
DEFAULT_JOB_DESCRIPTION=Experienced professional responsible for owning a measurable operational outcome, running the process day to day, handling escalations, reporting on metrics to stakeholders, and improving results over time.
