# ---------------------------------------------------------------------------
# ProofScreen API — copy to .env and fill in.
# Everything here has a working default EXCEPT OPENAI_API_KEY.
# With no OPENAI_API_KEY the whole pipeline still runs in FIXTURE MODE:
# deterministic heuristic claims / questions / evidence, no network calls.
# ---------------------------------------------------------------------------

# --- database -------------------------------------------------------------
# docker compose overrides this to point at the `db` service.
# For a bare `uvicorn` run against the compose Postgres, use localhost:
DATABASE_URL=postgresql+asyncpg://proofscreen:proofscreen@localhost:5432/proofscreen

# --- llm ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
LLM_TIMEOUT_SECONDS=25
LLM_TEMPERATURE_EXTRACT=0.0
LLM_TEMPERATURE_QUESTION=0.4

# --- conversation policy --------------------------------------------------
MAX_QUESTIONS=5
MAX_CLAIMS=3
# Cut-list switch #2: false => fixed question order instead of adaptive follow-ups
ADAPTIVE_FOLLOWUPS=true
# Score each answer inline (needed for adaptive follow-ups). false => background task.
SCORE_INLINE=true

# --- twilio whatsapp sandbox ---------------------------------------------
# Leave blank to run the webhook in dry-run mode (it still replies via TwiML).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=false
# Public https base url of this API, used only for signature validation:
PUBLIC_BASE_URL=

# --- api ------------------------------------------------------------------
# Comma-separated. * = open (chosen for the hackathon build).
CORS_ORIGINS=*
ENABLE_DEV_ENDPOINTS=true

# --- resume_score contrast metric ----------------------------------------
# resume_score is keyword overlap against a job description. When a candidate
# is uploaded without one, this is used so the dashboard always has a number.
DEFAULT_JOB_DESCRIPTION=Support operations lead responsible for a large customer support team, CSAT improvement, escalation workflow design, SLA management, queue and staffing planning, stakeholder reporting, and process automation.
